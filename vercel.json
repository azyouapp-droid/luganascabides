{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/inicio"
    },
    {
      "destination": "/cabides.html",
      "source": "/cabides"
    },
    {
      "destination": "/bustos.html",
      "source": "/bustos"
    },
    {
      "destination": "/manequins.html",
      "source": "/manequins"
    },
    {
      "destination": "/expositores.html",
      "source": "/expositores"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/inicio",
      "permanent": true
    },
    {
      "source": "/cabides.html",
      "destination": "/cabides",
      "permanent": true
    },
    {
      "source": "/bustos.html",
      "destination": "/bustos",
      "permanent": true
    },
    {
      "source": "/manequins.html",
      "destination": "/manequins",
      "permanent": true
    },
    {
      "source": "/expositores.html",
      "destination": "/expositores",
      "permanent": true
    }
  ]
}
